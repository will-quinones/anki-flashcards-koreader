-- Optional bootstrap file. Prefer the native KOReader settings menu.
-- Copy to configuration.lua only if you want file-based defaults.
-- Never publish configuration.lua or your saved API keys.
local CONFIGURATION = {
    text_provider = "dashscope",
    dashscope_api_key = "YOUR_DASHSCOPE_API_KEY",
    model = "qwen-plus", -- AI model, NOT an Anki note type.
    target_language = "English", -- The book/card language; e.g. "Spanish".

    -- Vocabulary extras are optional. Learn always uses text and source quotes.
    image_provider = "none",
    tts_enabled = false,

    anki = {
        url = "http://YOUR_HOST_IP:8765", -- Computer running Anki, never localhost.
        deck = "KOReader",              -- Destination when not organizing by book.
        deck_mode = "book",             -- "book" or "configured".
        -- book_parent = "KOReader",    -- Optional parent for book decks.
        split_card_types = false,       -- Subdecks Vocabulario / Aprendizaje.
        -- Names are requested in the UI when choosing an organization by type.
        -- vocab_deck_name = "Vocabulario",
        -- learn_deck_name = "Aprendizaje",
        auto_send_wifi = false,
        tags = {},                      -- Extra tags; KOReader tags are automatic.
    },
}
-- KOReader Vocabulary and KOReader Learn are managed automatically.
-- Provider credentials/models, images, audio and cloud can be set in the UI.
return CONFIGURATION
